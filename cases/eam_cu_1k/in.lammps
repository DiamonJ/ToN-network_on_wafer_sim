# EAM Copper benchmark - 1k atoms (7x7x7 FCC, ~1,372 atoms)
units           metal
boundary        p p p
atom_style      atomic

lattice         fcc 3.615
region          box block 0 7 0 7 0 7
create_box      1 box
create_atoms    1 box

mass            1 63.546

pair_style      eam
pair_coeff      1 1 Cu_u3.eam

velocity        all create 300.0 12345 units box

neighbor        0.3 bin
neigh_modify    delay 0 every 1

fix             1 all nve

thermo          10
thermo_style    custom step temp pe ke etotal press vol

run             100
