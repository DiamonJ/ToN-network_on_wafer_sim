# LiAlOCl - 2688 atoms, strong-scaling study (fixed total size)
# 4x2x4 replica of 84-atom base system; ranks = 4/8/16/32
# NOTE: keep "timer normal" (or higher) so phase markers are emitted.
units           metal
boundary        p p p
atom_style      charge

read_data       ./data.LiAlOCl_nvt_charge
replicate       4 2 2

set type 1 charge 1.0          # Li+
set type 2 charge 3.0          # Al3+
set type 3 charge -1.0         # Cl-
set type 4 charge -2.0         # O2-

pair_style      lj/cut/coul/long 10.0 10.0
pair_coeff      1 1 0.001 1.506
pair_coeff      2 2 0.010 1.044
pair_coeff      3 3 0.100 4.417
pair_coeff      4 4 0.150 3.500

kspace_style    pppm 1.0e-4

minimize        1.0e-4 1.0e-6 100 1000
reset_timestep  0

timestep        0.001

velocity        all create 600.0 12345

neighbor        0.3 bin
neigh_modify    delay 0 every 1

fix             1 all nve

thermo          10
thermo_style    custom step temp pe ke etotal press vol

variable        STEPS index 100
run             ${STEPS}
