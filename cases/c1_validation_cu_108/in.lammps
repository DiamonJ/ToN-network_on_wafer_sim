# Held-out EAM C1 validation scene: 3^3 FCC cells = 108 Cu atoms.
units           metal
boundary        p p p
atom_style      atomic
processors      2 2 1

lattice         fcc 3.615
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box

mass            1 63.546
pair_style      eam
pair_coeff      * * ../../runs/pipeline/short_cu_256a_4r_20260914_194538/Cu_u3.eam

velocity        all create 300.0 12345 units box
timestep        0.001
neighbor        0.3 bin
neigh_modify    delay 0 every 1
fix             1 all nve
thermo          100
run             1
