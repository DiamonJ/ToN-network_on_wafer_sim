# 2-type LJ + Coulomb long-range (864 atoms)
# FCC 6^3 x 4 = 864 atoms, 2 types equally distributed
units           metal
boundary        p p p
atom_style      charge

lattice         fcc 4.0
region          box block 0 6 0 6 0 6
create_box      2 box
create_atoms    1 box
group type2 id 2:864:2
set group type2 type 2

# 交替分配 +0.01/-0.01 电荷，保证净电荷为 0
set type 1 charge 0.01
set type 2 charge -0.01

mass            1 1.0
mass            2 1.0

pair_style      lj/cut/coul/long 10.0 10.0
pair_coeff      1 1 1.0 1.0 10.0
pair_coeff      2 2 1.0 1.0 10.0
pair_coeff      1 2 1.0 1.0 10.0

kspace_style    pppm 1.0e-4

minimize        1.0e-4 1.0e-6 100 1000
reset_timestep  0

timestep        0.001

velocity        all create 0.1 12345

neighbor        0.3 bin
neigh_modify    delay 0 every 1

fix             1 all nve

thermo          10
thermo_style    custom step temp pe ke etotal press vol

variable        STEPS index 100
run             ${STEPS}