# Phase-3 WSE 64-rank short-range experiment case.
units           metal
boundary        p p p
atom_style      charge
processors      8 8 1

read_data       ../lialocl_coul_2688/data.LiAlOCl_nvt_charge
replicate       2 4 4

set             type 1 charge 1.0
set             type 2 charge 3.0
set             type 3 charge -1.0
set             type 4 charge -2.0

pair_style      lj/cut/coul/cut 10.0
pair_coeff      1 1 0.001 1.506
pair_coeff      2 2 0.010 1.044
pair_coeff      3 3 0.100 4.417
pair_coeff      4 4 0.150 3.500

timestep        0.001
velocity        all create 600.0 12345
neighbor        0.3 bin
neigh_modify    delay 0 every 1
fix             1 all nve
thermo          10
run             1
