# LJ benchmark - 10k atoms (14x14x14 FCC, ~10,976 atoms)
units           lj
boundary        p p p
atom_style      atomic

lattice         fcc 0.8442
region          box block 0 14 0 14 0 14
create_box      1 box
create_atoms    1 box

mass            1 1.0

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

velocity        all create 1.0 12345

neighbor        0.3 bin
neigh_modify    delay 0 every 1

fix             1 all nve

thermo          10
thermo_style    custom step temp pe ke etotal press vol

run             100
