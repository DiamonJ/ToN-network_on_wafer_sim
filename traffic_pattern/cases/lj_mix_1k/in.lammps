# LJ binary mixture - 1k atoms (7x7x7 FCC, ~1,372 atoms, A-B 50:50)
units           lj
boundary        p p p
atom_style      atomic

lattice         fcc 0.8442
region          box block 0 7 0 7 0 7
create_box      2 box
create_atoms    1 box

# Randomly assign type 2 to 50% of atoms
set             type 1 type/ratio 2 0.5 54321

mass            1 1.0
mass            2 1.0

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
pair_coeff      1 2 1.5 1.0 2.5
pair_coeff      2 2 2.0 1.0 2.5

velocity        all create 1.0 12345

neighbor        0.3 bin
neigh_modify    delay 0 every 1

fix             1 all nve

thermo          10
thermo_style    custom step temp pe ke etotal press vol

run             100
